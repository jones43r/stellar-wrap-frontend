{
  "name": "next-version",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-env.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:integration:watch": "vitest --config vitest.config.ts",
    "test:integration:ui": "vitest --ui --config vitest.config.ts",
    "test:hooks": "vitest run --config vitest.hooks.config.ts",
    "test:components": "vitest run --config vitest.config.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:ci": "pnpm test:unit --ci && pnpm test:integration",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "playwright test --project=e2e-chromium",
    "e2e": "playwright test --project=e2e-chromium",
    "e2e:ui": "playwright test --project=e2e-chromium --ui",
    "test:visual": "playwright test --project=visual-chromium",
    "test:visual:update": "playwright test --project=visual-chromium --update-snapshots",
    "test:visual:ci": "playwright test --project=visual-chromium --ignore-snapshots=false",
    "vitest": "vitest",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lhci": "lhci autorun",
    "lhci:local": "lhci autorun",
    "prepare": "husky install",
    "analyze": "ANALYZE=true next build",
    "validate:env": "node scripts/validate-env.js",
    "optimize:archetypes": "node scripts/optimize-archetypes.mjs",
    "check:archetype-budget": "node scripts/check-archetype-budget.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.54",
    "@creit-tech/stellar-wallets-kit": "npm:@jsr/creit-tech__stellar-wallets-kit@^2.0.0-beta.9",
    "@stellar/freighter-api": "^6.0.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/web-push": "^3.6.4",
    "@vercel/kv": "^3.0.0",
    "@vercel/og": "^0.8.6",
    "ai": "^3.4.10",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.0",
    "gifenc": "^1.0.3",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.29.2",
    "next": "^16.1.4",
    "next-intl": "^4.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.12.0",
    "resend": "^6.25.0",
    "sonner": "^2.0.7",
    "stellar-sdk": "^13.3.0",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@lhci/cli": "^0.14.0",
    "@next/bundle-analyzer": "^16.1.4",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/nextjs": "^10.4.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.0.18",
    "ansi-styles": "^6.2.1",
    "autocannon": "7.15.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "husky": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.12",
    "sharp": "^0.35.5",
    "storybook": "^10.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
