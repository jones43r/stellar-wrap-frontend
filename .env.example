# Stellar Wrap Environment Variables
# Copy this file to .env.local and fill in your values

# Contract Addresses (Soroban format: 56 chars starting with C)
# At least one contract address must be set; `pnpm build` fails otherwise
NEXT_PUBLIC_CONTRACT_ADDRESS_MAINNET=
NEXT_PUBLIC_CONTRACT_ADDRESS_TESTNET=

# Legacy contract address (used for both networks if above are not set)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Secret for authenticating scheduled cron requests
CRON_SECRET=

# WalletConnect (optional)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Soroban RPC endpoints (optional - defaults provided)
NEXT_PUBLIC_SOROBAN_RPC_URL_MAINNET=https://soroban-rpc.mainnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL_TESTNET=https://soroban-rpc.testnet.stellar.org

# Server-side Rate Limiting for /api/wrapped
# Secret used to authorize /api/notifications/dispatch cron requests
CRON_SECRET=
# Window duration in seconds (default: 60)
RATE_LIMIT_WINDOW_SECONDS=60
# Maximum requests allowed per IP address per window (default: 30)
RATE_LIMIT_IP_MAX=30
# Maximum requests allowed per queried Stellar account per window (default: 10)
RATE_LIMIT_ACCOUNT_MAX=10
