# Playwright
# Keep committed visual regression baselines reviewable in pull requests.
# Only transient Playwright output is ignored; the baseline snapshots under
# app/visual-tests/ (e.g. *-snapshots/) are intentionally tracked so that
# baseline changes show up as reviewable image diffs in a PR.
test-results/
playwright-report/
blob-report/
playwright/.cache/
